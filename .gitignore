# Dependencies
node_modules/

# Build output from the Vite plugin and Wrangler
build/
dist/
.wrangler/

# Generated types, recreated by `pnpm typegen`
.react-router/
worker-configuration.d.ts

# Local secrets
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Setup state with email addresses and secret hashes, which setup deletes when it finishes
setup.local.json

# Working files of coding agents: plans, the working copies of subagents, and what browser tools
# write. The linter and the formatter skip ignored paths, so a nested working copy doesn't fail
# `pnpm verify`.
.plans/
.claude/worktrees/
.playwright-mcp/

# Test and compiler output
coverage/
*.tsbuildinfo

# Operating system files
.DS_Store
